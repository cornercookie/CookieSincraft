{
  "productName": "CookieSincraft",
  "version": "0.1.0",
  "identifier": "com.cookiesincraft.dev",
  "build": {
    "frontendDist": "gen/dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "CookieSincraft 曲奇芯刻",
        "width": 1200,
        "height": 800
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "plugins": {
    "dialog": null
  }
}
