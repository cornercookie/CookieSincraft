{
  "productName": "CookieSincraft",
  "version": "0.2.0",
  "identifier": "com.cookiesincraft.dev",
  "build": {
    "frontendDist": "gen/dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "CookieSincraft 曲奇芯刻",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}